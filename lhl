-- 拖动功能
local dragging = false
local dragStart, dragPos

local function startDrag(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        dragPos = Vector2.new(MainWindow.Position.X.Offset, MainWindow.Position.Y.Offset)
    end
end

local function endDrag(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end

local function updateDrag(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainWindow.Position = UDim2.new(0, dragPos.X + delta.X, 0, dragPos.Y + delta.Y)
    end
end

TitleBar.InputBegan:Connect(startDrag)
TitleBar.InputEnded:Connect(endDrag)
game:GetService('UserInputService').InputChanged:Connect(updateDrag)
game:GetService('UserInputService').InputEnded:Connect(endDrag)

