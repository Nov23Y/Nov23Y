local function u206()
    local keywords = {'+','Coin','Strength','Exp','Experience','Level','Health'}
    local protects = {'MobileWindUI','Crazy Top','Rayfield','KJY_Team_AntiDup'}

    local function clean(parent)
        pcall(function()
            for _,gui in ipairs(parent:GetChildren()) do
                if gui:IsA('ScreenGui') then
                    local keep = false
                    for _,n in ipairs(protects) do
                        if gui.Name:find(n) then
                            keep = true
                            break
                        end
                    end
                    if not keep then
                        for _,d in ipairs(gui:GetDescendants()) do
                            if (d:IsA('TextLabel') or d:IsA('TextButton')) and d.Text then
                                for _,k in ipairs(keywords) do
                                    if d.Text:find(k) then
                                        gui:Destroy()
                                        break
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end)
    end

    clean(game:GetService('CoreGui'))
    if _LocalPlayer.PlayerGui then
        clean(_LocalPlayer.PlayerGui)
    end
end

