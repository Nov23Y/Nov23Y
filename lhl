local punchConnection = nil
bug:Toggle({
    Title = "挥拳",
    Value = false,
    Callback = function(Value)
        if punchConnection then
            punchConnection:Disconnect()
            punchConnection = nil
        end
        
        if Value then
            punchConnection = game:GetService("RunService").Heartbeat:Connect(function()
                pcall(function()
                    local args = {[1] = "punch", [2] = "leftHand"}
                    game:GetService("Players").LocalPlayer.muscleEvent:FireServer(unpack(args))
                    
                    local backpack = Players.LocalPlayer.Backpack
                    local character = Players.LocalPlayer.Character
                    if backpack:FindFirstChild("Punch") and character then
                        character.Humanoid:EquipTool(backpack.Punch)
                    end
                end)
            end)
        end
    end
})