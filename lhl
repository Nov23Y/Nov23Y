local function startStatsUpdate()
    local lastTime = tick()
    while ScreenGui and ScreenGui.Parent do
        task.wait(u159)
        pcall(function()
            local ls = _LocalPlayer:FindFirstChild('leaderstats')
            local str = ls and ls:FindFirstChild('Strength')
            if not str then return end
            local val = str.Value
            local now = tick()

            StrengthLabel.Text = 'Now '..u163(val)

            if u158 > 0 then
                local dt = now - lastTime
                local gain = val - u158
                local spd = gain / math.max(0.1, dt)
                table.insert(u169, spd)
                while #u169 > u170 do
                    table.remove(u169,1)
                end
                local avg = u176()
                SpeedValue.Text = string.format('%.1f/s', spd)
                DailyValue.Text = u163(avg * 86400)
            end

            u158 = val
            lastTime = now
        end)
    end
end
