            local fill = Instance.new("Frame")
            fill.Size = UDim2.new(0, 0, 1, 0)
            fill.BackgroundColor3 = C.Slider
            fill.BorderSizePixel = 0
            fill.ZIndex = 11
            fill.Parent = track
            local fillCorner = Instance.new("UICorner")
            fillCorner.CornerRadius = UDim.new(1, 0)
            fillCorner.Parent = fill
    
            local knob = Instance.new("Frame")
            knob.AnchorPoint = Vector2.new(0.5, 0.5)
            knob.Position = UDim2.new(0, 0, 0.5, 0)
            knob.Size = UDim2.fromOffset(16, 16)
            knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            knob.BorderSizePixel = 0
            knob.ZIndex = 12
            knob.Parent = track
            local knobCorner = Instance.new("UICorner")
            knobCorner.CornerRadius = UDim.new(1, 0)
            knobCorner.Parent = knob
    
            local hit = Instance.new("TextButton")
            hit.Position = UDim2.new(0, 0, 0, -12)
            hit.Size = UDim2.new(1, 0, 1, 24)
            hit.BackgroundTransparency = 1
            hit.Text = ""
            hit.AutoButtonColor = false
            hit.ZIndex = 13
            hit.Parent = track
    
            local value = math.clamp(default, min, max)
            local dragging = false
    
            local function text(v)
                if rounding == 0 then return tostring(math.floor(v + 0.5)) end
                return string.format("%." .. rounding .. "f", v)
            end
    
            local function apply(v, fire)
                value = math.clamp(v, min, max)
                local alpha = (max > min) and ((value - min) / (max - min)) or 0
                fill.Size = UDim2.new(alpha, 0, 1, 0)
                knob.Position = UDim2.new(alpha, 0, 0.5, 0)
                valueLabel.Text = text(value)
                if fire and onChanged then onChanged(value) end
            end
    
            apply(value, false)
    
            local function fromX(x)
                local width = track.AbsoluteSize and track.AbsoluteSize.X or 200
                local left = track.AbsolutePosition and track.AbsolutePosition.X or 0
                local rel = (x - left) / math.max(width, 1)
                rel = math.clamp(rel, 0, 1)
                apply(min + (max - min) * rel, true)
            end
    
            hit.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    tween(knob, 0.12, { Size = UDim2.fromOffset(20, 20) })
                    fromX(input.Position.X)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    fromX(input.Position.X)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                    dragging = false
                    tween(knob, 0.15, { Size = UDim2.fromOffset(16, 16) })
                end
            end)
    
            return {
                Set = function(_, v)
                    value = v
                    apply(v, false)
                end,
                Get = function() return value end,
            }
        end
    
        --============================== Dropdown ==============================--
        __WC.Dropdown = function(parent, paramA, paramB)
            -- 兼容两种调用： (values, default, multi, onChanged)  /  (config, panelContent, contentArea)
            -- 用 ClassName 判断更稳（Luau 与模拟器都成立）
            local isLegacy = type(paramB) == "table" and paramB.ClassName ~= nil
            local values, default, multi, onChanged, panelContent, contentArea, cardParent, cardOrder
    
            if isLegacy then
                local config = paramA
                values = config.Values or {}
                default = config.Default
                multi = config.Multi == true
                onChanged = config.OnChanged
                panelContent = paramB
                contentArea = config.ContentArea
                cardParent = config.Parent
                cardOrder = config.Order
            else
                values = paramA or {}
                default = paramB
                multi = false
                onChanged = nil
                cardParent = parent
            end
    
            -- default 可能是字符串 / 表 / 甚至 Instance，统一只保留能当文本用的值
            local function asText(v)
                if type(v) == "string" then return v end
                if type(v) == "number" then return tostring(v) end
                return nil
            end
    
            local selected = {}
            if type(default) == "table" then
                for _, v in ipairs(default) do
                    local t = asText(v)
                    if t then table.insert(selected, t) end
                end
            else
                local t = asText(default)
                if t then table.insert(selected, t) end
            end
            if #selected == 0 then
                local first = asText(values[1])
                if first then table.insert(selected, first) end
            end
    
            local label = table.concat(selected, ", ")
    
            local card = baseCard(cardParent, cardOrder or 0, 56)
            card:SetAttribute("imgui_mousepos", true)
    
            local title = Instance.new("TextLabel")
            title.Position = UDim2.new(0, 12, 0, 6)
            title.Size = UDim2.new(1, -24, 0, 14)
            title.BackgroundTransparency = 1
            title.Font = Enum.Font.GothamMedium
            title.Text = "选择"
            title.TextColor3 = C.Text
            title.TextSize = 11
            title.TextXAlignment = Enum.TextXAlignment.Left
            title.ZIndex = 10
            title.Parent = card
    
            local btn = Instance.new("TextButton")
            btn.Position = UDim2.new(0, 12, 0, 24)
            btn.Size = UDim2.new(1, -24, 0, 24)
            btn.BackgroundColor3 = C.Background
            btn.BackgroundTransparency = 0.25
            btn.BorderSizePixel = 0
            btn.Text = ""
            btn.AutoButtonColor = false
            btn.ZIndex = 10
            btn.Parent = card
            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 6)
            btnCorner.Parent = btn
    
            local btnStroke = Instance.new("UIStroke")
            btnStroke.Color = C.Outline
            btnStroke.Transparency = 0.9
            btnStroke.Thickness = 1
            btnStroke.Parent = btn
    
            local btnLabel = Instance.new("TextLabel")
            btnLabel.Position = UDim2.new(0, 8, 0, 0)
            btnLabel.Size = UDim2.new(1, -32, 1, 0)
            btnLabel.BackgroundTransparency = 1
            btnLabel.Font = Enum.Font.Gotham
            btnLabel.Text = label
            btnLabel.TextColor3 = label ~= "" and C.Text or C.Placeholder
            btnLabel.TextSize = 11
            btnLabel.TextXAlignment = Enum.TextXAlignment.Left
            btnLabel.TextTruncate = Enum.TextTruncate.AtEnd
            btnLabel.ZIndex = 11
            btnLabel.Parent = btn
    
            local arrow = Instance.new("TextLabel")
            arrow.AnchorPoint = Vector2.new(1, 0.5)
            arrow.Position = UDim2.new(1, -8, 0.5, 0)
            arrow.Size = UDim2.fromOffset(14, 14)
            arrow.BackgroundTransparency = 1
            arrow.Font = Enum.Font.GothamBold
            arrow.Text = "▾"
            arrow.TextColor3 = C.Icon
            arrow.TextSize = 11
            arrow.ZIndex = 11
            arrow.Parent = btn
    
            local listOpen = false
            local listFrame, maskBtn
            local selectedSet = {}
            for _, v in ipairs(selected) do selectedSet[v] = true end
    
            local closeList
            closeList = function()
                if not listOpen then return end
                listOpen = false
                if listFrame then
                    local lf = listFrame
                    listFrame = nil
                    tween(lf, 0.12, { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0) })
                    task.delay(0.12, function() lf:Destroy() end)
                end
                if maskBtn then maskBtn:Destroy() maskBtn = nil end
            end
    
            local function fire()
                if onChanged then
                    if type(selected) == "table" and (multi or isLegacy) then
                        onChanged(multi and selected or selected[1])
                    else
                        onChanged(selected[1])
                    end
                end
            end
    
            local function openList()
                if listOpen or #values == 0 then return end
                listOpen = true
    
                local itemH = 22
                local listHeight = #values * itemH + 8
    
                listFrame = Instance.new("Frame")
                listFrame.BackgroundColor3 = Color3.fromRGB(24, 24, 26)
                listFrame.BackgroundTransparency = 0.05
                listFrame.BorderSizePixel = 0
                listFrame.ZIndex = 95
                listFrame.ClipsDescendants = true
                listFrame.Parent = panelContent or card.Parent.Parent
                local lc = Instance.new("UICorner")
                lc.CornerRadius = UDim.new(0, 8)
                lc.Parent = listFrame
                local ls = Instance.new("UIStroke")
                ls.Color = C.Outline
                ls.Transparency = 0.88
                ls.Thickness = 1
                ls.Parent = listFrame
                local lpad = Instance.new("UIPadding")
                lpad.PaddingTop = UDim.new(0, 4)
                lpad.PaddingBottom = UDim.new(0, 4)
                lpad.Parent = listFrame
                local llayout = Instance.new("UIListLayout")
                llayout.SortOrder = Enum.SortOrder.LayoutOrder
                llayout.Parent = listFrame
    
                task.defer(function()
                    if not listFrame or not listFrame.Parent then return end
                    local btnAbs = btn.AbsolutePosition
                    local btnSize = btn.AbsoluteSize
                    local parent = listFrame.Parent
                    local parentAbs = parent.AbsolutePosition
                    local parentSize = parent.AbsoluteSize
                    local relX = btnAbs.X - parentAbs.X
                    local relY = btnAbs.Y - parentAbs.Y
                    local targetY = relY + btnSize.Y + 2
                    if targetY + listHeight > parentSize.Y - 4 then
                        targetY = relY - listHeight - 2
                        if targetY < 4 then targetY = 4 end
                    end
                    listFrame.Position = UDim2.fromOffset(math.round(relX), math.round(targetY))
                    listFrame.Size = UDim2.fromOffset(math.round(btnSize.X), listHeight)
                end)
    
                local startY = UDim2.new(0, 10, 0.5, 0)
                listFrame.Size = UDim2.new(1, 0, 0, 0)
                for i, opt in ipairs(values) do
                    local isSel = selectedSet[opt] == true
                    local ob = Instance.new("TextButton")
                    ob.Size = UDim2.new(1, -8, 0, itemH)
                    ob.BackgroundColor3 = C.Primary
                    ob.BackgroundTransparency = isSel and 0.75 or 1
                    ob.BorderSizePixel = 0
                    ob.Text = ""
                    ob.AutoButtonColor = false
                    ob.ZIndex = 96
                    ob.LayoutOrder = i
                    ob.Parent = listFrame
                    local oc = Instance.new("UICorner")
                    oc.CornerRadius = UDim.new(0, 5)
                    oc.Parent = ob
    
                    local dot = Instance.new("Frame")
                    dot.AnchorPoint = Vector2.new(0, 0.5)
                    dot.Position = UDim2.new(0, 8, 0.5, 0)
                    dot.Size = UDim2.fromOffset(6, 6)
                    dot.BackgroundColor3 = C.Primary
                    dot.BorderSizePixel = 0
                    dot.Visible = isSel
                    dot.ZIndex = 97
                    dot.Parent = ob
                    local dc = Instance.new("UICorner")
                    dc.CornerRadius = UDim.new(1, 0)
                    dc.Parent = dot
    
                    local ol = Instance.new("TextLabel")
                    ol.AnchorPoint = Vector2.new(0, 0.5)
                    ol.Position = UDim2.new(0, 20, 0.5, 0)
                    ol.Size = UDim2.new(1, -26, 1, 0)
                    ol.BackgroundTransparency = 1
                    ol.Font = Enum.Font.Gotham
                    ol.Text = opt
                    ol.TextColor3 = isSel and C.Primary or C.Text
                    ol.TextSize = 11
                    ol.TextXAlignment = Enum.TextXAlignment.Left
                    ol.ZIndex = 97
                    ol.Parent = ob
    
                    ob.MouseEnter:Connect(function()
                        if not isSel then tween(ob, 0.12, { BackgroundTransparency = 0.92 }) end
                    end)
                    ob.MouseLeave:Connect(function()
                        if not isSel then tween(ob, 0.12, { BackgroundTransparency = 1 }) end
                    end)
                    ob.MouseButton1Click:Connect(function()
                        if multi then
                            if selectedSet[opt] then
                                selectedSet[opt] = nil
                                local keep = {}
                                for _, v in ipairs(selected) do if v ~= opt then table.insert(keep, v) end end
                                selected = keep
                                dot.Visible = false
                                ob.BackgroundTransparency = 1
                                ol.TextColor3 = C.Text
                            else
                                selectedSet[opt] = true
                                table.insert(selected, opt)
                                dot.Visible = true
                                ob.BackgroundTransparency = 0.75
                                ol.TextColor3 = C.Primary
                            end
                            btnLabel.Text = table.concat(selected, ", ")
                            btnLabel.TextColor3 = #selected > 0 and C.Text or C.Placeholder
                            fire()
                        else
                            selected = { opt }
                            selectedSet = { [opt] = true }
                            btnLabel.Text = opt
                            btnLabel.TextColor3 = C.Text
                            closeList()
                            onChanged(opt)
                        end
                    end)
                end
            end
    
            btn.MouseButton1Click:Connect(function()
                if listOpen then closeList() else openList() end
            end)
            btn.MouseEnter:Connect(function()
                tween(btnStroke, 0.15, { Transparency = 0.6 })
            end)
            btn.MouseLeave:Connect(function()
                tween(btnStroke, 0.15, { Transparency = 0.9 })
            end)
    
            if contentArea then
                pcall(function()
                    contentArea:GetPropertyChangedSignal("CanvasPosition"):Connect(function() closeList() end)
                end)
            end
    
            local obj = {}
            obj.Close = closeList
            obj.Set = function(_, v)
                selected = type(v) == "table" and v or { v }
                selectedSet = {}
                for _, item in ipairs(selected) do selectedSet[item] = true end
                btnLabel.Text = table.concat(selected, ", ")
                btnLabel.TextColor3 = #selected > 0 and C.Text or C.Placeholder
                fire()
            end
            obj.Get = function() return selected end
            return card, obj
        end
    end

