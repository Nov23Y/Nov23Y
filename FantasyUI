        query = string.lower(query or "")
        for _, tab in ipairs(tabs) do
            for _, child in ipairs(tab.content:GetChildren()) do
                if child:IsA("Frame") then
                    local key = child:GetAttribute("SearchKey")
                    if key then
                        if query == "" then
                            child.Visible = true
                        else
                            child.Visible = string.find(string.lower(key), query, 1, true) ~= nil
                        end
                    end
                end
            end
        end
    end

