        -- WindUI：24 高胶囊轨道，圆形滑块 20px，开启时滑块右移并填满绿色
        __WC.Toggle = function(parent, title, desc, defaultOn, order, onChanged)
            local card = baseCard(parent, order, desc and 52 or 44)
            titleLabel(card, title, desc, 20)
    
            local trackW, trackH = 42, 24
            local knobSize = 20
            local kOffset = 2
            local kOn = trackW - knobSize - kOffset
    
            local track = Instance.new("TextButton")
            track.AnchorPoint = Vector2.new(1, 0.5)
            track.Position = UDim2.new(1, -12, 0.5, 0)
            track.Size = UDim2.fromOffset(trackW, trackH)
            track.BackgroundColor3 = Color3.fromRGB(88, 88, 96)
            track.BackgroundTransparency = 0
            track.BorderSizePixel = 0
            track.Text = ""
            track.AutoButtonColor = false
            track.ZIndex = 10
            track.Parent = card
            local trackCorner = Instance.new("UICorner")
            trackCorner.CornerRadius = UDim.new(1, 0)
            trackCorner.Parent = track
    
            local trackStroke = Instance.new("UIStroke")
            trackStroke.Color = C.Outline
            trackStroke.Transparency = 0.8
            trackStroke.Thickness = 1
            trackStroke.Parent = track
    
            local trackInner = Instance.new("Frame")
            trackInner.AnchorPoint = Vector2.new(0.5, 1)
            trackInner.Position = UDim2.new(0.5, 0, 1, -1)
            trackInner.Size = UDim2.new(1, -2, 0.5, -1)
            trackInner.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            trackInner.BackgroundTransparency = 0.85
            trackInner.BorderSizePixel = 0
            trackInner.ZIndex = 10
            trackInner.Parent = track
            local innerCorner = Instance.new("UICorner")
            innerCorner.CornerRadius = UDim.new(1, 0)
            innerCorner.Parent = trackInner
    
            local knob = Instance.new("Frame")
            knob.AnchorPoint = Vector2.new(0, 0.5)
            knob.Position = UDim2.new(0, defaultOn and kOn or kOffset, 0.5, 0)
            knob.Size = UDim2.fromOffset(knobSize, knobSize)
            knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            knob.BackgroundTransparency = 0
            knob.BorderSizePixel = 0
            knob.ZIndex = 11
            knob.Parent = track
            local knobCorner = Instance.new("UICorner")
            knobCorner.CornerRadius = UDim.new(1, 0)
            knobCorner.Parent = knob
    
            local state = defaultOn
            local animating = false
    
            local function apply(on, animate)
                if animate then
                    tween(knob, 0.35, { Position = UDim2.new(0, on and kOn or kOffset, 0.5, 0) },
                        Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                    tween(knob, 0.15, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quint)
                    tween(track, 0.18, { BackgroundColor3 = on and C.Toggle or C.Button })
                else
                    knob.Position = UDim2.new(0, on and kOn or kOffset, 0.5, 0)
                    knob.BackgroundTransparency = 0
                    track.BackgroundColor3 = on and C.Toggle or C.Button
                end
            end
    
            apply(state, false)
    
            track.MouseButton1Click:Connect(function()
                if animating then return end
                animating = true
                state = not state
                apply(state, true)
                if onChanged then onChanged(state) end
                task.delay(0.3, function() animating = false end)
            end)
            track.MouseEnter:Connect(function()
                if not state then tween(track, 0.15, { BackgroundTransparency = 0 }) end
            end)
            track.MouseLeave:Connect(function()
                if not state then tween(track, 0.15, { BackgroundTransparency = 0.15 }) end
            end)
    
            return {
                Set = function(_, v)
                    v = v and true or false
                    if v == state then return end
                    state = v
                    apply(state, true)
                    if onChanged then onChanged(state) end
                end,
                Get = function() return state end,
            }
        end
    
