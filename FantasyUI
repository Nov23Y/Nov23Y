        if not isPanelOpen then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then return end
            dragging = true
            dragMoved = false
            dragStartPos = Vector2.new(input.Position.X, input.Position.Y)
            dragStartX = panelX
            dragStartY = panelY
        end
    end)

    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        if isPanelOpen then
            panelX, panelY = clampPos(panelX, panelY, CONFIG.ExpandedWidth, CONFIG.ExpandedHeight)
            applyPanelPos(panelX, panelY)
        end
    end)

    do
        local vp = workspace.CurrentCamera.ViewportSize
        panelX = vp.X * 0.5
        panelY = getIslandBottom() + CONFIG.IslandGap
        applyPanelPos(panelX, panelY)
    end

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.K and not gui.Enabled then
            cancelTweens()
            isPanelOpen = false
            dragging = false
            modalOpen = false
            pulseToken = nil
            panelFrame.Visible = false
            panelFrame.BackgroundTransparency = CONFIG.PanelTransparency
            panelContent.GroupTransparency = 0
            modalMask.Visible = false
            modalMask.BackgroundTransparency = 1
            island.Size = UDim2.fromOffset(CONFIG.IslandWidth, CONFIG.IslandHeight)
            islandCorner.CornerRadius = UDim.new(0, CONFIG.IslandRadius)
            islandLabel.Text = CONFIG.IslandName
            setIconColor(CONFIG.Color.Green)
            toastToken = nil
            searchBox.Text = ""
            local vp = workspace.CurrentCamera.ViewportSize
            panelX = vp.X * 0.5
            panelY = getIslandBottom() + CONFIG.IslandGap
            applyPanelPos(panelX, panelY)
            gui.Enabled = true
        end
    end)

    local window = {}
    window.__index = window

    function window:Tab(opts)
        opts = opts or {}
        local tabTitle = opts.Title or "Tab"
        local tabIcon = opts.Icon or "●"
        local order = #tabs + 1

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 28)
        btn.BackgroundColor3 = CONFIG.Color.TabActive
        btn.BackgroundTransparency = 1
        btn.BorderSizePixel = 0
        btn.Text = ""
        btn.AutoButtonColor = false
        btn.LayoutOrder = order
        btn.ZIndex = 8
        btn.Parent = tabContainer
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 7)
        corner.Parent = btn

        local iconBg = Instance.new("Frame")
        iconBg.AnchorPoint = Vector2.new(0, 0.5)
        iconBg.Position = UDim2.new(0, 6, 0.5, 0)
        iconBg.Size = UDim2.fromOffset(18, 18)
        iconBg.BackgroundColor3 = opts.IconColor or Color3.fromRGB(90, 140, 255)
        iconBg.BorderSizePixel = 0
        iconBg.ZIndex = 9
        iconBg.Parent = btn
        local iconBgCorner = Instance.new("UICorner")
        iconBgCorner.CornerRadius = UDim.new(0, 5)
        iconBgCorner.Parent = iconBg
        local iconLabel = Instance.new("TextLabel")
        iconLabel.Size = UDim2.fromScale(1, 1)
        iconLabel.BackgroundTransparency = 1
        iconLabel.Font = Enum.Font.GothamBold
        iconLabel.Text = tabIcon
        iconLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        iconLabel.TextSize = 10
        iconLabel.ZIndex = 10
        iconLabel.Parent = iconBg

        local label = Instance.new("TextLabel")
        label.AnchorPoint = Vector2.new(0, 0.5)
        label.Position = UDim2.new(0, 30, 0.5, 0)
        label.Size = UDim2.new(1, -34, 1, 0)
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.GothamMedium
        label.Text = tabTitle
        label.TextColor3 = CONFIG.Color.SubText
        label.TextSize = 10
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.ZIndex = 9
        label.Parent = btn

        local content = Instance.new("ScrollingFrame")
        content.Name = "Tab" .. order
        content.BackgroundTransparency = 1
        content.BorderSizePixel = 0
        content.Position = UDim2.fromScale(0, 0)
        content.Size = UDim2.fromScale(1, 1)
        content.CanvasSize = UDim2.new(0, 0, 0, 0)
        content.AutomaticCanvasSize = Enum.AutomaticSize.Y
        content.ScrollBarThickness = 3
        content.ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255)
        content.ScrollBarImageTransparency = 0.7
        content.Visible = false
        content.ZIndex = 8
        content.Parent = contentArea
        local layout = Instance.new("UIListLayout")
        layout.FillDirection = Enum.FillDirection.Vertical
        layout.SortOrder = Enum.SortOrder.LayoutOrder
        layout.Padding = UDim.new(0, 6)
        layout.Parent = content

        table.insert(tabs, { button = btn, label = label, content = content })
        btn.MouseButton1Click:Connect(function() switchTab(order) end)
        if #tabs == 1 then switchTab(1) end

        local tabOrder = 0
        local function nextOrder()
            tabOrder = tabOrder + 1
            return tabOrder
        end

        local tabObj = {}
        tabObj.__index = tabObj

        function tabObj:Section(title)
            if type(title) == "table" then title = title.Title or "" end
            createSectionTitle(content, title, nextOrder())
        end

        function tabObj:Button(opts)
            opts = opts or {}
            createCardButton(content, opts.Title or "按钮", opts.Color, nextOrder(), opts.Callback)
        end

        function tabObj:Toggle(opts)
            opts = opts or {}
            createCardToggle(content, opts.Title or "开关", opts.Desc, opts.Value or opts.Default or false, nextOrder(), opts.Callback)
        end

        function tabObj:Input(opts)
            opts = opts or {}
            createCardInput(content, opts.Title or "输入", opts.Placeholder, opts.Textarea, nextOrder(), opts.Callback)
        end

        function tabObj:Slider(opts)
            opts = opts or {}
            local rounding = opts.Rounding or 0
            createCardSlider(content, opts.Title or "滑块", opts.Desc, opts.Min or 0, opts.Max or 100, opts.Default or 50, rounding, nextOrder(), opts.Callback)
        end

        function tabObj:Dropdown(opts)
            opts = opts or {}
            local values = opts.Values or {}
            local default = opts.Value or opts.Default
            local multi = opts.Multi == true
            createCardDropdown(content, opts.Title or "下拉", values, default, multi, nextOrder(), opts.Callback)
        end

        function tabObj:Paragraph(opts)
            opts = opts or {}
            createCardParagraph(content, opts.Title or "", opts.Desc or "", opts.Buttons, nextOrder())
        end

        return tabObj
    end

    function window:Notify(opts)
        opts = opts or {}
        local content = opts.Content or opts.Title or "通知"
        showToast(content)
    end

    function window:Popup(opts)
        opts = opts or {}
        showModal()
    end

    function window:Open() openPanel() end
    function window:Close() closePanel() end
    function window:Destroy() gui:Destroy() end
    function window:SetVisible(v)
        gui.Enabled = v and true or false
    end

    return window
end

return FantasyUI
