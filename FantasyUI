    local modalOpen = false
    local function showModal()
        if modalOpen then return end
        if closeActiveDropdown then closeActiveDropdown() end
        modalOpen = true
        modalMask.Visible = true
        modalMask.BackgroundTransparency = 1
        modalFrame.Size = UDim2.fromOffset(240, 132)
        local info = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        TweenService:Create(modalMask, TweenInfo.new(0.22), { BackgroundTransparency = 0.5 }):Play()
        TweenService:Create(modalFrame, info, { Size = UDim2.fromOffset(280, 148) }):Play()
    end

    local function hideModal(onDone)
        if not modalOpen then
            if onDone then onDone() end
            return
        end
        modalOpen = false
        TweenService:Create(modalMask, TweenInfo.new(0.18), { BackgroundTransparency = 1 }):Play()
        TweenService:Create(modalFrame, TweenInfo.new(0.18), { Size = UDim2.fromOffset(260, 140) }):Play()
        task.delay(0.18, function()
            modalMask.Visible = false
            if onDone then onDone() end
        end)
    end

    local function applyPanelPos(x, y)
        panelFrame.Position = UDim2.fromOffset(math.round(x), math.round(y))
    end

    local function getIslandBottom()
        return CONFIG.TopOffset + CONFIG.IslandHeight
    end

    openPanel = function()
        if isPanelOpen then return end
        isPanelOpen = true
        cancelTweens()
        local vp = workspace.CurrentCamera.ViewportSize
        if panelX == nil or panelY == nil then
            panelX = vp.X * 0.5
            panelY = getIslandBottom() + CONFIG.IslandGap
        end
        panelX, panelY = clampPos(panelX, panelY, CONFIG.ExpandedWidth, CONFIG.ExpandedHeight)
        applyPanelPos(panelX, panelY)
        panelFrame.Visible = true
        panelFrame.BackgroundTransparency = 1
        panelContent.GroupTransparency = 1
        local info = TweenInfo.new(CONFIG.ExpandTime, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        playTween(panelFrame, info, { BackgroundTransparency = CONFIG.PanelTransparency })
        playTween(panelContent, TweenInfo.new(CONFIG.ExpandTime * 0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { GroupTransparency = 0 })
    end

    closePanel = function(onDone)
        if not isPanelOpen then
            if onDone then onDone() end
            return
        end
        if closeActiveDropdown then closeActiveDropdown() end
        isPanelOpen = false
        cancelTweens()
        dragging = false
        local info = TweenInfo.new(CONFIG.CollapseTime, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
        playTween(panelFrame, info, { BackgroundTransparency = 1 })
        playTween(panelContent, info, { GroupTransparency = 1 })
        task.delay(CONFIG.CollapseTime, function()
            if not isPanelOpen then panelFrame.Visible = false end
            if onDone then onDone() end
        end)
    end

    closeUI = function()
        hideModal(function()
            closePanel(function()
                gui.Enabled = false
                isPanelOpen = false
                panelFrame.Visible = false
                modalMask.Visible = false
            end)
        end)
    end

    cancelBtn.MouseButton1Click:Connect(function() hideModal() end)
    confirmBtn.MouseButton1Click:Connect(function() closeUI() end)
    ball.MouseButton1Click:Connect(function() showModal() end)
    islandBtn.MouseButton1Click:Connect(function()
        pulseIsland()
        if isPanelOpen then closePanel() else openPanel() end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if not isPanelOpen then dragging = false return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local pos = Vector2.new(input.Position.X, input.Position.Y)
            local delta = pos - dragStartPos
            if not dragMoved and delta.Magnitude > CONFIG.DragThreshold then
                dragMoved = true
                cancelTweens()
            end
            if dragMoved then
                local nx, ny = clampPos(dragStartX + delta.X, dragStartY + delta.Y, CONFIG.ExpandedWidth, CONFIG.ExpandedHeight)
                panelX, panelY = nx, ny
                applyPanelPos(nx, ny)
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

