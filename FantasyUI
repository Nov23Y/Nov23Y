function FantasyUI:CreateWindow(config)
    config = config or {}

    local keySystem = config.KeySystem
    if keySystem and keySystem.Key and #keySystem.Key > 0 then
        local keyFile = config.KeyFile or DEFAULT_KEY_FILE
        local saveKey = keySystem.SaveKey ~= false

        if not checkSavedKey(keySystem, keyFile) then
            local done = false
            buildKeyUI(keySystem, keyFile, saveKey, function()
                done = true
            end)
            repeat task.wait(0.05) until done
        end
    end

    local CONFIG = {}
    for k, v in pairs(DEFAULTS) do CONFIG[k] = v end
    for k, v in pairs(config) do
        if k == "Color" and type(v) == "table" then
            for ck, cv in pairs(v) do CONFIG.Color[ck] = cv end
        elseif k ~= "KeySystem" and k ~= "KeyFile" then
            CONFIG[k] = v
        end
    end
    if config.Title then CONFIG.IslandName = config.Title end

    local isPanelOpen, dragging, dragMoved = false, false, false
    local dragStartPos = Vector2.new()
    local dragStartX, dragStartY = 0, 0
    local panelX, panelY = nil, nil
    local activeTweens = {}
    local openPanel, closePanel, closeUI
    local toastToken = nil
