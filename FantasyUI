            function section:Keybind(o)
                o = o or {}
                local card, element = createCardKeybind(body, nextSecOrder(), o, registerFlag)
                if o.Flag and element then table.insert(tabObj.Elements, element) end
                return element
            end

            function section:Divider()
                createDivider(body, nextSecOrder())
            end

            function section:Section(o)
                o = o or {}
                local t = o.Title or ""
                local label = Instance.new("TextLabel", body)
                label.Size = UDim2.new(1,0,0,22)
                label.BackgroundTransparency = 1
                label.Font = Enum.Font.GothamBold
                label.Text = t
                label.TextColor3 = CONFIG.Color.Text
                label.TextSize = 12
                label.TextXAlignment = Enum.TextXAlignment.Left
                label.LayoutOrder = nextSecOrder()
                label.ZIndex = 9
                return { Title = t }
            end

            return section
        end

        local __defSec = nil
        local function __getDefSec()
            if not __defSec then
                __defSec = tabObj:Section({Title="", Box=false})
            end
            return __defSec
        end
        tabObj.Button    = function(self, o) return __getDefSec():Button(o)    end
        tabObj.Toggle    = function(self, o) return __getDefSec():Toggle(o)    end
        tabObj.Slider    = function(self, o) return __getDefSec():Slider(o)    end
        tabObj.Input     = function(self, o) return __getDefSec():Input(o)     end
        tabObj.Dropdown  = function(self, o) return __getDefSec():Dropdown(o)  end
        tabObj.Paragraph = function(self, o) return __getDefSec():Paragraph(o) end
        tabObj.Keybind   = function(self, o) return __getDefSec():Keybind(o)   end
        tabObj.Divider   = function(self)    return __getDefSec():Divider()    end
        tabObj.Select    = function(self) end

        return tabObj
    end

    function window:Notify(opts)
        opts = opts or {}
        local text = opts.Content or opts.Title or "通知"
        showToast(text)
    end

    function window:Popup(opts)
        opts = opts or {}
        showModal(opts)
    end

    function window:Dialog(opts)
        return window:Popup(opts)
    end

    function window:Open() openPanel() end
    function window:Close() closePanel() end
    function window:Destroy() gui:Destroy() end
    function window:SetVisible(v) gui.Enabled = v and true or false end

    function window:CreateConfig(name)
        local cfg = {
            Name = name or "default",
            Path = "fantasy_configs/" .. (name or "default") .. ".json",
        }
        function cfg:Save()
            local data = {}
            for flag, el in pairs(windowAllElements) do
                if el.__type == "Toggle" then
                    data[flag] = { __type = "Toggle", value = el.Get() }
                elseif el.__type == "Slider" then
                    data[flag] = { __type = "Slider", value = el.Get() }
                elseif el.__type == "Input" then
                    data[flag] = { __type = "Input", value = el.Get() }
                elseif el.__type == "Dropdown" then
                    data[flag] = { __type = "Dropdown", value = el.Get() }
                elseif el.__type == "Keybind" then
                    data[flag] = { __type = "Keybind", value = el.Get() }
                end
            end
            if writefile then
                if isfolder and not isfolder("fantasy_configs") then
                    pcall(makefolder, "fantasy_configs")
                end
                pcall(writefile, self.Path, HttpService:JSONEncode(data))
            end
            return true
        end
        function cfg:Load()
            if not (isfile and isfile(self.Path)) then return false end
            local ok, data = pcall(function() return HttpService:JSONDecode(readfile(self.Path)) end)
            if not ok or type(data) ~= "table" then return false end
            for flag, entry in pairs(data) do
                local el = windowAllElements[flag]
                if el and el.Set and entry.value ~= nil then
                    pcall(function() el:Set(entry.value) end)
                end
            end
            return true
        end
        function cfg:Delete()
            if delfile and isfile and isfile(self.Path) then
                pcall(delfile, self.Path)
            end
        end
        return cfg
    end

    return window
end

return FantasyUI
