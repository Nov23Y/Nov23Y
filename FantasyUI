local function checkSavedKey(keySystem, keyFile)
    if not keySystem or not keySystem.Key then return true end
    if keySystem.SaveKey == false then return false end
    if not isfile then return false end
    if not isfile(keyFile) then return false end
    local ok, data = pcall(readfile, keyFile)
    if not ok or not data then return false end
    data = data:gsub("%s+","")
    for _, k in ipairs(keySystem.Key) do
        if k == data then return true end
    end
    return false
end

