    dragStrip.Text = ""
    dragStrip.AutoButtonColor = false
    dragStrip.ZIndex = 20
    dragStrip.Parent = sideBar
    dragStrip.InputBegan:Connect(function(input)
        if not isPanelOpen then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if closeActiveDropdown then closeActiveDropdown() end
            dragging = true
            dragMoved = false
            dragStartPos = Vector2.new(input.Position.X, input.Position.Y)
            dragStartX = panelX
            dragStartY = panelY
        end
    end)

    sideBar.InputBegan:Connect(function(input)
        if not isPanelOpen then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then return end
            dragging = true
            dragMoved = false
            dragStartPos = Vector2.new(input.Position.X, input.Position.Y)
            dragStartX = panelX
            dragStartY = panelY
        end
    end)

    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        if isPanelOpen then
            panelX, panelY = clampPos(panelX, panelY, CONFIG.ExpandedWidth, CONFIG.ExpandedHeight)
            applyPanelPos(panelX, panelY)
        end
    end)

    do
        local vp = workspace.CurrentCamera.ViewportSize
        panelX = vp.X * 0.5
        panelY = getIslandBottom() + CONFIG.IslandGap
        applyPanelPos(panelX, panelY)
    end

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.KeyCode == Enum.KeyCode.K and not gui.Enabled then
            cancelTweens()
            isPanelOpen = false
            dragging = false
            modalOpen = false
            pulseToken = nil
            panelFrame.Visible = false
            panelFrame.BackgroundTransparency = CONFIG.PanelTransparency
            panelContent.GroupTransparency = 0
            modalMask.Visible = false
            modalMask.BackgroundTransparency = 1
            island.Size = UDim2.fromOffset(CONFIG.IslandWidth, CONFIG.IslandHeight)
            islandCorner.CornerRadius = UDim.new(0, CONFIG.IslandRadius)
            islandLabel.Text = CONFIG.IslandName
            setIconColor(CONFIG.Color.Green)
            toastToken = nil
            searchBox.Text = ""
            local vp = workspace.CurrentCamera.ViewportSize
            panelX = vp.X * 0.5
            panelY = getIslandBottom() + CONFIG.IslandGap
            applyPanelPos(panelX, panelY)
            gui.Enabled = true
        end
    end)

