    local CONFIG = {}
    for k, v in pairs(DEFAULTS) do CONFIG[k] = v end
    for k, v in pairs(config) do
        if k == "Color" and type(v) == "table" then
            for ck, cv in pairs(v) do CONFIG.Color[ck] = cv end
        elseif k ~= "KeySystem" and k ~= "KeyFile" then
            CONFIG[k] = v
        end
    end
    if config.Title then CONFIG.IslandName = config.Title end

    local isPanelOpen, dragging, dragMoved = false, false, false
    local dragStartPos = Vector2.new()
