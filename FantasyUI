        f.BackgroundTransparency = 1
        local s = Instance.new("UIStroke", f)
        s.Color = color
        s.Thickness = t or 1.5
        local c = Instance.new("UICorner", f)
        c.CornerRadius = UDim.new(1, 0)
        return f
    end

