        local f = Instance.new("Frame", parent)
        f.Position = UDim2.fromScale(x, y)
        f.Size = UDim2.fromScale(w, h)
        f.BackgroundColor3 = color
        f.BorderSizePixel = 0
        if r and r > 0 then
            local c = Instance.new("UICorner", f)
            if r == 1 then c.CornerRadius = UDim.new(1, 0)
            else c.CornerRadius = UDim.new(0, r) end
        end
        return f
    end

    local function O(x, y, w, h, t)
        local f = Instance.new("Frame", parent)
        f.Position = UDim2.fromScale(x, y)
