            TweenService:Create(tab.label, TweenInfo.new(0.18, Enum.EasingStyle.Quart), {
                TextColor3 = active and Color3.fromRGB(255, 255, 255) or CONFIG.Color.SubText
            }):Play()
            if tab.iconGlow then
                TweenService:Create(tab.iconGlow, TweenInfo.new(0.22, Enum.EasingStyle.Quart), {
                    BackgroundTransparency = active and 0.25 or 0.6,
                    Size = active and UDim2.fromOffset(32, 32) or UDim2.fromOffset(26, 26),
                }):Play()
            end
        end
        if applySearch then task.defer(function() applySearch(searchBox.Text) end) end
    end

    applySearch = function(query)
        query = string.lower(query or "")
        for _, tab in ipairs(tabs) do
            for _, sec in ipairs(tab.content:GetChildren()) do
                if sec:IsA("Frame") and sec.Name == "Section" then
                    local anyVisible = false
                    local bodyFrame = sec:FindFirstChild("Body")
                    if bodyFrame then
                        for _, card in ipairs(bodyFrame:GetChildren()) do
                            if card:IsA("Frame") and card.Name == "Card" then
                                local key = card:GetAttribute("SearchKey")
                                if key then
                                    if query == "" then
                                        card.Visible = true
                                    else
                                        card.Visible = string.find(string.lower(key), query, 1, true) ~= nil
                                    end
                                    if card.Visible then anyVisible = true end
                                end
                            end
                        end
                    end
                    sec.Visible = (query == "") or anyVisible
                end
            end
        end
    end

