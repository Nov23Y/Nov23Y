        return __WC.Slider(parent, label, desc, min, max, default, rounding, order, onChanged)
    end
    local function createCardDropdown(parent, label, values, default, multi, order, onChanged)
        local card, api = __WC.Dropdown({
            Parent = parent,
            Values = values,
            Default = default,
            Multi = multi,
            Order = order,
            OnChanged = onChanged,
        }, panelContent, contentArea)
        if card then
            for _, child in ipairs(card:GetChildren()) do
                if child:IsA("TextLabel") and child.Text == "选择" then
                    child.Text = label or "下拉"
                    break
                end
            end
        end
        return card, api
    end



