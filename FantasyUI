        local hasDesc = opts.Desc and opts.Desc ~= ""
        local h = hasDesc and 66 or 58
        local card = createCard(parent, order, h, makeSearchKey(opts.Title, opts.Desc))

        local icon = createIcon(card, opts.Icon, 18, CONFIG.Color.IconColor)
