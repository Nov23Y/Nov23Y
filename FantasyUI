        arrow.Position = UDim2.new(1,-8,0.5,0)

        local listOpen = false
        local listFrame, maskBtn, scrollConn

        local function closeList()
            if listFrame then listFrame:Destroy() listFrame = nil end
            if maskBtn then maskBtn:Destroy() maskBtn = nil end
            if scrollConn then scrollConn:Disconnect() scrollConn = nil end
            if closeActiveDropdown == closeList then closeActiveDropdown = nil end
            listOpen = false
            arrow.Rotation = 0
        end

        btn.MouseButton1Click:Connect(function()
            if listOpen then closeList() return end
            if closeActiveDropdown and closeActiveDropdown ~= closeList then closeActiveDropdown() end
            listOpen = true
            closeActiveDropdown = closeList
            arrow.Rotation = 180

            maskBtn = Instance.new("TextButton",panelContent)
            maskBtn.Size = UDim2.fromScale(1,1)
            maskBtn.BackgroundTransparency = 1
            maskBtn.Text = ""
            maskBtn.AutoButtonColor = false
            maskBtn.ZIndex = 93
            maskBtn.MouseButton1Click:Connect(function() closeList() end)

            local itemH = 24
            local listHeight = #values * itemH + 6
            listFrame = Instance.new("Frame",panelContent)
            listFrame.BackgroundColor3 = CONFIG.Color.DropdownBg
            listFrame.BackgroundTransparency = 0.1
            listFrame.BorderSizePixel = 0
            listFrame.ZIndex = 95
            Instance.new("UICorner",listFrame).CornerRadius = UDim.new(0,6)
            local ls = Instance.new("UIStroke",listFrame)
            ls.Color = Color3.fromRGB(255,255,255)
            ls.Transparency = 0.88
            ls.Thickness = 1
            local lpad = Instance.new("UIPadding",listFrame)
            lpad.PaddingTop = UDim.new(0,3)
            lpad.PaddingBottom = UDim.new(0,3)
            lpad.PaddingLeft = UDim.new(0,2)
            lpad.PaddingRight = UDim.new(0,2)
            local llayout = Instance.new("UIListLayout",listFrame)
            llayout.SortOrder = Enum.SortOrder.LayoutOrder

            task.defer(function()
                if not listFrame or not listFrame.Parent then return end
                local btnAbs = btn.AbsolutePosition
                local btnSize = btn.AbsoluteSize
                local parentAbs = panelContent.AbsolutePosition
                local parentSize = panelContent.AbsoluteSize
                local relX = btnAbs.X - parentAbs.X
                local relY = btnAbs.Y - parentAbs.Y
                local targetY = relY + btnSize.Y + 2
                if targetY + listHeight > parentSize.Y - 4 then
                    targetY = relY - listHeight - 2
                    if targetY < 4 then targetY = 4 end
                end
                listFrame.Position = UDim2.fromOffset(math.round(relX), math.round(targetY))
                listFrame.Size = UDim2.fromOffset(math.round(btnSize.X), listHeight)
            end)

            local selectedSet = {}
            if multi then
                for _, v in ipairs(selected) do selectedSet[v]=true end
            end

            for i, opt in ipairs(values) do
                local isSel = multi and selectedSet[opt] or (selected == opt)
                local ob = Instance.new("TextButton",listFrame)
                ob.Size = UDim2.new(1,0,0,itemH)
                ob.BackgroundColor3 = isSel and CONFIG.Color.Accent or Color3.fromRGB(45,45,52)
                ob.BackgroundTransparency = isSel and 0 or 1
                ob.BorderSizePixel = 0
                ob.Text = ""
                ob.AutoButtonColor = false
                ob.ZIndex = 96
                ob.LayoutOrder = i
                Instance.new("UICorner",ob).CornerRadius = UDim.new(0,4)
                local ol = Instance.new("TextLabel",ob)
                ol.AnchorPoint = Vector2.new(0,0.5)
                ol.Position = UDim2.new(0,10,0.5,0)
                ol.Size = UDim2.new(1,-16,1,0)
                ol.BackgroundTransparency = 1
                ol.Font = Enum.Font.Gotham
                ol.Text = tostring(opt)
                ol.TextColor3 = Color3.fromRGB(255,255,255)
                ol.TextSize = 10
                ol.TextXAlignment = Enum.TextXAlignment.Left
                ol.ZIndex = 97

                ob.MouseButton1Click:Connect(function()
                    if multi then
                        if selectedSet[opt] then
                            selectedSet[opt] = nil
                            ob.BackgroundTransparency = 1
                            ob.BackgroundColor3 = Color3.fromRGB(45,45,52)
                            for idx, v in ipairs(selected) do
                                if v == opt then table.remove(selected, idx) break end
                            end
                        else
                            selectedSet[opt] = true
                            table.insert(selected, opt)
                            ob.BackgroundTransparency = 0
                            ob.BackgroundColor3 = CONFIG.Color.Accent
                        end
                        btnLabel.Text = table.concat(selected, ", ")
                        if opts.Callback then task.spawn(opts.Callback, selected) end
                    else
                        selected = opt
                        btnLabel.Text = tostring(opt)
                        closeList()
                        if opts.Callback then task.spawn(opts.Callback, opt) end
                    end
                end)
            end
        end)

        local element = {
            __type = "Dropdown",
            Get = function() return multi and selected or selected end,
            Set = function(v)
                if multi and type(v) == "table" then
                    selected = v
                    btnLabel.Text = table.concat(selected, ", ")
                else
                    selected = v
                    btnLabel.Text = tostring(v)
                end
