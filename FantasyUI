        local tx = opts.Icon and 38 or 12

        local title = newLabel(card, opts.Title or "Slider", tx, 8, 0, 16, 11, CONFIG.Color.Text, true)
        title.Size = UDim2.new(1,-tx-64,0,16)

        local valueLbl = newLabel(card, "", 0, 8, 0, 16, 11, CONFIG.Color.Pink, true, Enum.TextXAlignment.Right)
        valueLbl.Size = UDim2.new(0,52,0,16)
        valueLbl.AnchorPoint = Vector2.new(1,0)
        valueLbl.Position = UDim2.new(1,-12,0,8)

        if hasDesc then
            local d = newLabel(card, opts.Desc, tx, 24, 0, 12, 8, CONFIG.Color.SubText, false)
            d.Size = UDim2.new(1,-tx-24,0,12)
        end

        local min, max, rounding, state
        local Value = opts.Value
        if type(Value) == "table" then
            min = Value.Min or 0
            max = Value.Max or 100
            state = Value.Default or min
        else
            min = opts.Min or 0
            max = opts.Max or 100
            state = opts.Default or opts.Value or min
        end
        rounding = opts.Rounding or 0

        local barBg = Instance.new("Frame",card)
        barBg.Position = UDim2.new(0,12,1,-18)
        barBg.Size = UDim2.new(1,-24,0,5)
        barBg.BackgroundColor3 = Color3.fromRGB(60,60,70)
        barBg.BorderSizePixel = 0
        barBg.ZIndex = 10
        Instance.new("UICorner",barBg).CornerRadius = UDim.new(1,0)

        local rel0 = (state-min)/(max-min)
        local barFill = Instance.new("Frame",barBg)
        barFill.Size = UDim2.new(rel0,0,1,0)
        barFill.BackgroundColor3 = CONFIG.Color.SliderFill
        barFill.BorderSizePixel = 0
        barFill.ZIndex = 10
        Instance.new("UICorner",barFill).CornerRadius = UDim.new(1,0)

        local handle = Instance.new("Frame",barBg)
        handle.AnchorPoint = Vector2.new(0.5,0.5)
        handle.Position = UDim2.new(rel0,0,0.5,0)
        handle.Size = UDim2.fromOffset(10,10)
        handle.BackgroundColor3 = CONFIG.Color.Knob
        handle.BorderSizePixel = 0
        handle.ZIndex = 11
        Instance.new("UICorner",handle).CornerRadius = UDim.new(1,0)

        local clickArea = Instance.new("TextButton",barBg)
        clickArea.Size = UDim2.new(1,0,3,0)
        clickArea.Position = UDim2.new(0,0,-1,0)
        clickArea.BackgroundTransparency = 1
        clickArea.Text = ""
        clickArea.AutoButtonColor = false
        clickArea.ZIndex = 12

        local function fmt(v)
            if rounding > 0 then
                return string.format("%."..rounding.."f", v)
            end
            return tostring(math.round(v))
        end

        local function apply(v, noCallback)
            state = v
            local rel = math.clamp((v-min)/(max-min),0,1)
            barFill.Size = UDim2.new(rel,0,1,0)
            handle.Position = UDim2.new(rel,0,0.5,0)
            valueLbl.Text = fmt(v)
            if not noCallback and opts.Callback then task.spawn(opts.Callback, v) end
        end
        apply(state, true)

        local dragging = false
        local function updateFromX(x)
            local rel = math.clamp((x - barBg.AbsolutePosition.X)/barBg.AbsoluteSize.X, 0, 1)
            local raw = min + (max-min)*rel
            local v
            if rounding > 0 then
                v = math.round(raw * 10^rounding)/10^rounding
            else
                v = math.round(raw)
            end
            apply(v)
        end
        clickArea.MouseButton1Down:Connect(function()
            dragging = true
            updateFromX(UserInputService:GetMouseLocation().X)
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateFromX(input.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        local element = {
            __type = "Slider",
            Get = function() return state end,
            Set = function(v) apply(v) end,
        }
        if opts.Flag and onFlag then onFlag(opts.Flag, element) end
        return card, element
    end

